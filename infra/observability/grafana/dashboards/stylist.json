  {
   "id": 11,
   "type": "timeseries",
   "title": "Product searches per chat turn",
   "description": "A normal turn needs about 8 (a top and a bottom for four outfits). Much higher means retries.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 18,
    "w": 8,
