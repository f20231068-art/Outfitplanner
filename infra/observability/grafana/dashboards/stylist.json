   "title": "Outfits delivered per hour, by colour confidence",
   "description": "'low' = the store never stated the colour, so it was trusted from the search. A high share of low is a data-quality signal.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
