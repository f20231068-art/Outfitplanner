# Copy to .env and fill in. NEVER put real secrets in this file: it is committed to git.
# A test (services/api/tests/test_repo_hygiene.py) fails if a real-looking secret appears here.

# --- Chat model ---
# "<provider>/<model-id>", provider = openrouter | opencode
STYLIST_MODEL=openrouter/apodex/apodex-1.1-mini:free
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
# (opencode only) endpoint style if the guess from the model name is wrong: chat | responses
LLM_API_MODE=
# json_schema | function_calling | json_mode  (function_calling works with the free OpenRouter model)
STRUCTURED_OUTPUT_METHOD=function_calling
# Force IPv4 if the first request in a process hangs ~40s (IPv6 stall)
FORCE_IPV4=true

# --- Product search ---
SERPAPI_API_KEY=

# --- Image generation (not built yet: the provider is undecided) ---
IMAGE_PROVIDER=
IMAGE_MODEL=

# --- Postgres (docker compose). The password below is a local-development default: change it when deploying. ---
POSTGRES_USER=stylist
POSTGRES_PASSWORD=stylist_dev_password
POSTGRES_DB=stylist
DATABASE_URL=postgresql://stylist:stylist_dev_password@localhost:5432/stylist

# --- Signed-token keys (JWT, RS256). Create them with:
#   uv run --project services/mcp python scripts/generate_jwt_keys.py
# Two separate pairs, so a token for one purpose can never be accepted for the other.
# Hosting: the MCP service gets ONLY MCP_JWT_PUBLIC_KEY. The API service gets the other three.
MCP_JWT_PRIVATE_KEY=
MCP_JWT_PUBLIC_KEY=
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=

# --- API <-> MCP tool server ---
MCP_URL=http://127.0.0.1:8001/mcp
MCP_PORT=8001
# Clock tolerance (seconds) between API and tool server. Keep small: each second lengthens a token's life.
MCP_JWT_LEEWAY_S=10
MCP_JWT_MAX_LIFETIME_S=60
# How long the API makes each tool-server token live (a new one is minted for every request)
MCP_JWT_TTL_S=30
# Limits on the tool server: they cap the damage, they do not keep anyone out
MCP_RATE_LIMIT_PER_MIN=60
MCP_DAILY_CREDITS_PER_USER=40
MCP_DAILY_CREDITS_GLOBAL=100
# Extra Host names the tool server may be reached by when deployed (comma-separated), e.g. its private service name
MCP_ALLOWED_HOSTS=

# --- API ---
API_PORT=8000
# The browser origin allowed to call the API (CORS)
WEB_ORIGIN=http://localhost:3000
# true when served over https (the login cookie is then marked Secure). MUST be true in production.
COOKIE_SECURE=false
# prod = interactive API docs switched off
ENVIRONMENT=dev
# Comma-separated emails allowed to use /admin endpoints (verifying the audit log)
ADMIN_EMAILS=

# --- Web app ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend mode ---
# live = real chat model + real product search. demo = deterministic offline stand-ins (free; for evals and dashboards).
# demo is refused when ENVIRONMENT=prod. It tests the plumbing, never the model's taste.
BACKEND_MODE=live

# --- Observability (local stack: docker compose --profile observability up -d) ---
# Created by `python scripts/init_observability.py`. Prometheus uses it to read /metrics. Empty = metrics off.
METRICS_TOKEN=
# Grafana admin password (Grafana is bound to 127.0.0.1 only)
GRAFANA_ADMIN_PASSWORD=

# --- Mastra (evals, tracing, audit): apps/mastra ---
STYLIST_API_URL=http://localhost:8000
# Evaluation shopper accounts (created on first use). Cases are spread across EVAL_USERS accounts so the API's
# per-user rate limits stay on. Leave the email/password empty to use the built-in defaults.
EVAL_USERS=4
EVAL_USER_EMAIL=
EVAL_USER_PASSWORD=
# Also send traces to a local OpenTelemetry backend, e.g. Jaeger: http://localhost:4318/v1/traces
OTEL_TRACES_ENDPOINT=
